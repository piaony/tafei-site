+.desktop-icon-item b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;font-weight:500}
+.desktop-icon-item small{display:block;margin-top:2px;color:var(--ang-muted);font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.desktop-icon-item.is-selected{border-color:rgba(110,231,255,.55);background:rgba(110,231,255,.13);box-shadow:0 0 0 1px rgba(110,231,255,.12) inset}
 @media(max-width:620px){
   .widget-settings{padding:10px;gap:8px}
   .ws-toggles{grid-template-columns:1fr 1fr;gap:7px 8px}
