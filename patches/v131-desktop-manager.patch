+.dm-cell:disabled{opacity:.35;cursor:default}
+.dm-target-hint{margin:8px 0 0;color:var(--ang-muted);font-size:10px;line-height:1.5}
+.dm-folder-name{margin-top:8px}
+.dm-folder-name[hidden]{display:none!important}
+.dm-folder-name input{width:100%;height:34px;padding:0 9px;border:1px solid rgba(255,211,110,.2);border-radius:9px;background:rgba(255,211,110,.05);color:#fff;font:inherit;font-size:11px;outline:none}
+.dm-target-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px;padding-top:9px;border-top:1px solid rgba(255,255,255,.09)}
+.dm-target-foot span{color:var(--ang-muted);font-size:10px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.dm-target-foot button{min-height:34px;padding:0 14px;border:1px solid rgba(255,211,110,.5);border-radius:9px;background:rgba(255,211,110,.16);color:var(--sp-gold);font:inherit;font-size:11px;cursor:pointer}
+.dm-target-foot button:disabled{opacity:.35;cursor:default}
+@media(max-width:380px){.dm-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.dm-actions button{font-size:10px}}
