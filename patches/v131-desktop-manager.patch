+.dm-db-toggle{display:flex;align-items:center;gap:7px;color:var(--ang-muted);font-size:10.5px;line-height:1.4;cursor:pointer}
+.dm-db-toggle input{accent-color:#6ee7ff;width:15px;height:15px}
+.dm-db-note{margin:5px 0 0;color:rgba(255,255,255,.42);font-size:9.5px;line-height:1.55}
+.dm-page-tabs{display:flex;gap:6px;overflow-x:auto;padding:9px 0 7px;scrollbar-width:none}
+.dm-page-tabs::-webkit-scrollbar{display:none}
+.dm-page-tab{flex:0 0 auto;min-height:28px;padding:0 11px;border:1px solid rgba(255,255,255,.1);border-radius:99px;background:rgba(255,255,255,.03);color:var(--ang-muted);font:inherit;font-size:10px;cursor:pointer;white-space:nowrap}
+.dm-page-tab.is-active{border-color:rgba(199,166,255,.5);background:rgba(199,166,255,.14);color:#efe7ff}
+.dm-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;max-height:420px;overflow:auto;padding:2px 1px 8px;overscroll-behavior:contain}
+.dm-app{position:relative;display:flex;flex-direction:column;align-items:center;min-width:0;padding:8px 3px 7px;border:1px solid rgba(255,255,255,.075);border-radius:11px;background:rgba(255,255,255,.028);color:var(--ang-text);font:inherit;cursor:pointer;transition:border-color .16s,background .16s,transform .16s}
+.dm-app:active{transform:scale(.97)}
+.dm-app.is-selected{border-color:rgba(255,211,110,.75);background:rgba(255,211,110,.12);box-shadow:0 0 0 1px rgba(255,211,110,.2) inset,0 6px 18px rgba(255,211,110,.08)}
+.dm-app.is-selected .dm-check{opacity:1;transform:scale(1)}
+.dm-icon{position:relative;display:flex;align-items:center;justify-content:center;width:42px;height:42px;margin-bottom:5px;border-radius:11px;background:rgba(255,255,255,.06);overflow:hidden}
+.dm-icon img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:transparent}
+.dm-icon i{color:#c7a6ff;font-style:normal;font-size:16px;font-weight:600}
+.dm-app b{display:block;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;font-size:10px;font-weight:500;line-height:1.35}
+.dm-app small{display:block;width:100%;margin-top:2px;color:var(--ang-muted);font-size:8px;line-height:1.3;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.dm-check{position:absolute;right:4px;top:4px;display:flex;align-items:center;justify-content:center;width:15px;height:15px;border-radius:50%;background:#ffd36e;color:#1a1630;font-size:9px;font-weight:700;opacity:0;transform:scale(.7);transition:.15s}
+.dm-empty{padding:22px 8px;color:var(--ang-muted);font-size:11px;text-align:center}
+.dm-empty[hidden]{display:none!important}
+.dm-dock{position:sticky;bottom:0;z-index:5;margin:2px -2px 0;padding:8px;border:1px solid rgba(199,166,255,.25);border-radius:12px;background:rgba(10,13,29,.96);box-shadow:0 -6px 22px rgba(8,13,27,.55);backdrop-filter:blur(10px)}
+.dm-selection{display:flex;align-items:baseline;justify-content:space-between;gap:8px;min-width:0;margin-bottom:7px}
+.dm-selection b{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ang-text);font-size:11px;font-weight:500}
+.dm-selection small{flex:0 0 auto;color:var(--ang-muted);font-size:9px}
+.dm-actions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px}
+.dm-action{min-height:33px;padding:0 4px;border:1px solid rgba(110,231,255,.25);border-radius:8px;background:rgba(110,231,255,.08);color:var(--sp-cyan);font:inherit;font-size:10.5px;cursor:pointer}
+.dm-action:disabled{opacity:.34;cursor:default}
+.dm-action.is-special{border-color:rgba(255,211,110,.35);background:rgba(255,211,110,.08);color:#ffd36e}
+.dm-command{display:grid;grid-template-columns:1fr auto;gap:6px;margin-top:8px}
+.dm-command input{min-width:0;min-height:34px;padding:0 10px;border:1px solid rgba(255,255,255,.1);border-radius:9px;background:rgba(255,255,255,.04);color:var(--ang-text);font:inherit;font-size:10.5px;outline:none}
+.dm-command input:focus{border-color:rgba(199,166,255,.5)}
+.dm-command button{min-height:34px;padding:0 12px;border:1px solid rgba(255,211,110,.36);border-radius:9px;background:rgba(255,211,110,.1);color:#ffd36e;font:inherit;font-size:10.5px;cursor:pointer}
+.dm-action-out{margin-top:8px;padding:8px 10px;border:1px solid rgba(110,231,255,.18);border-radius:9px;background:rgba(110,231,255,.06);color:var(--sp-cyan);font-size:10px;line-height:1.6}
+.dm-action-out[hidden]{display:none!important}
+.dm-action-out.is-error{border-color:rgba(255,120,150,.3);background:rgba(255,90,120,.07);color:#ff9fb2}
+.dm-diag{margin-top:9px}
+.dm-diag summary{color:rgba(255,255,255,.38);font-size:9.5px;cursor:pointer}
+.dm-diag .desktop-probe-out{max-height:220px;margin-top:7px}
+.dm-modal{position:fixed;inset:0;z-index:60;display:flex;align-items:flex-end;justify-content:center;background:rgba(4,5,13,.72);padding:12px}
+.dm-modal[hidden]{display:none!important}
+.dm-modal-card{width:100%;max-width:520px;max-height:82vh;overflow:auto;padding:14px 12px;border:1px solid rgba(199,166,255,.35);border-radius:16px;background:linear-gradient(180deg,#191631,#0b1021);box-shadow:0 18px 60px rgba(0,0,0,.55)}
+.dm-modal-head{display:flex;align-items:center;justify-content:space-between;gap:10px}
+.dm-modal-head b{color:var(--ang-text);font-size:13px}
+.dm-modal-head button{width:28px;height:28px;border:1px solid rgba(255,255,255,.12);border-radius:50%;background:rgba(255,255,255,.05);color:var(--ang-muted);font:inherit;font-size:16px;cursor:pointer}
+.dm-modal-note{margin:6px 0 0;color:var(--ang-muted);font-size:9.5px;line-height:1.5}
+.dm-target-grid{display:grid;gap:5px;margin-top:8px}
+.dm-cell{min-width:0;min-height:50px;padding:3px;border:1px solid rgba(255,255,255,.08);border-radius:8px;background:rgba(255,255,255,.025);color:var(--ang-muted);font:inherit;font-size:8px;line-height:1.25;cursor:pointer;overflow:hidden}
+.dm-cell.is-empty{border-color:rgba(110,231,255,.22);background:rgba(110,231,255,.055);color:rgba(110,231,255,.72)}
+.dm-cell.is-folder{border-color:rgba(255,211,110,.45);background:rgba(255,211,110,.09);color:#ffd36e}
+.dm-cell.is-app{opacity:.52;cursor:default}
+.dm-cell b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ang-text);font-size:8.5px;font-weight:500}
+.dm-cell small{display:block;margin-top:2px;color:inherit;font-size:7.5px}
+.dm-folder-name{display:flex;align-items:center;gap:7px;margin-top:10px;color:var(--ang-muted);font-size:10px}
+.dm-folder-name[hidden]{display:none!important}
+.dm-folder-name input{flex:1;min-width:0;min-height:32px;padding:0 9px;border:1px solid rgba(255,255,255,.1);border-radius:8px;background:rgba(255,255,255,.04);color:var(--ang-text);font:inherit;font-size:10.5px}
+.dm-target-hint{margin:9px 0 0;color:var(--ang-muted);font-size:9.5px;line-height:1.5}
+@media (max-width:360px){.dm-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.dm-icon{width:38px;height:38px}}
