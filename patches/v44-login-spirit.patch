diff --git a/www/js/spirit-extra.js b/www/js/spirit-extra.js
new file mode 100644
index 0000000..87826c9
--- /dev/null
+++ b/www/js/spirit-extra.js
@@ -0,0 +1,180 @@
+/* TAFEI 精灵扩充 · 场景台词 / 点击互动 / 陪伴经验（v1）
+   依赖 spirit-core.js（window.TafeiSpirits）与 spirit-widget.js（#spiritWidget）
+   不改动原挂件逻辑，只在旁边补一层气泡与被动成长 */
+(function () {
+  'use strict';
+
+  var SP = window.TafeiSpirits;
+  if (!SP) return;
+
+  var KEY = 'tafei-spirit-usage';
+  var root = null, extra = null;
+  var SPEECH = ['swSpeech', '#swSpeech'];
+
+  var LINES = {
+    greet: ['你来了，今天想先做哪件事？', '我一直在这儿，别急。', '刚刚把你上次的进度记住了。'],
+    night: ['都快半夜了，早点睡吧。', '夜深了，明天的课还等着你呢。', '再刷十分钟就休息，好不好？'],
+    click: ['诶？', '别戳我啦，痒。', '叫我做什么？', '今天心情不错嘛。', '你手气挺好。', '我在想晚饭吃什么。'],
+    comfort: ['没事的，页面出个错而已。', '别慌，刷新一下就好。', '我陪你再试一次。'],
+    growth: ['我们一起待了 %m 分钟，羁绊 +1。', '又靠近了一点，%m 分钟了。', '今天的陪伴也有记录哦。']
+  };
+
+  function loadUsage() {
+    try {
+      var raw = localStorage.getItem(KEY);
+      var o = raw ? JSON.parse(raw) : null;
+      if (!o || o.day !== dayKey()) return { day: dayKey(), seconds: 0, gain: 0 };
+      return o;
+    } catch (e) { return { day: dayKey(), seconds: 0, gain: 0 }; }
+  }
+
+  function dayKey() { return (SP.todayKey && SP.todayKey()) || new Date().toDateString(); }
+
+  function saveUsage(u) {
+    try { localStorage.setItem(KEY, JSON.stringify(u)); } catch (e) {}
+  }
+
+  var usage = loadUsage();
+
+  function pick(list) { return list[Math.floor(Math.random() * list.length)]; }
+
+  function speechBusy() {
+    var s = document.getElementById('swSpeech');
+    return !!(s && s.classList.contains('show'));
+  }
+
+  function ensureExtra() {
+    root = document.getElementById('spiritWidget');
+    if (!root) return false;
+    if (!extra || !extra.parentNode) {
+      extra = document.createElement('span');
+      extra.id = 'swExtra';
+      extra.setAttribute('aria-hidden', 'true');
+      extra.style.cssText = 'position:absolute;left:50%;bottom:calc(100% - 2px);transform:translateX(-50%);'
+        + 'max-width:190px;padding:7px 11px;border-radius:12px;font-size:11.5px;line-height:1.45;'
+        + 'text-align:center;color:#eef4ff;background:rgba(13,26,48,.92);'
+        + 'border:1px solid rgba(130,170,255,.38);box-shadow:0 8px 20px rgba(3,9,22,.42);'
+        + 'opacity:0;transition:opacity .26s ease,transform .26s ease;pointer-events:none;z-index:5;'
+        + 'white-space:normal;word-break:break-word';
+      root.appendChild(extra);
+    }
+    return true;
+  }
+
+  var bubbleTimer = 0, pendingTimer = 0, bubbleTries = 0;
+  function bubble(text, ms) {
+    if (!text) return;
+    if (!ensureExtra()) return;
+    if (!root || root.hidden) return;
+    if (speechBusy()) {
+      /* 原生台词还在播，等它说完再插一句，最多等 8 轮 */
+      if (bubbleTries >= 8) return;
+      bubbleTries++;
+      clearTimeout(pendingTimer);
+      pendingTimer = setTimeout(function () { bubble(text, ms); }, 700);
+      return;
+    }
+    bubbleTries = 0;
+    extra.textContent = text;
+    extra.style.opacity = '1';
+    extra.style.transform = 'translateX(-50%) translateY(-4px)';
+    clearTimeout(bubbleTimer);
+    bubbleTimer = setTimeout(function () {
+      extra.style.opacity = '0';
+      extra.style.transform = 'translateX(-50%)';
+    }, ms || 3600);
+  }
+
+  function currentSpirit() {
+    try {
+      var s = SP.current && SP.current();
+      return s || null;
+    } catch (e) { return null; }
+  }
+
+  function spiritName() {
+    var s = currentSpirit();
+    return (s && (s.short || s.name)) || '伙伴';
+  }
+
+  /* ---------- 场景一：深夜提醒（原生开场白说完再补） ---------- */
+  var nightDone = false, nightTries = 0;
+  function nightTip() {
+    if (nightDone) return;
+    var h = new Date().getHours();
+    if (h < 23 && h >= 5) { nightDone = true; return; }
+    if (!root || root.hidden) { nightDone = true; return; }
+    if (nightTries >= 12) { nightDone = true; return; }
+    if (speechBusy()) { nightTries++; setTimeout(nightTip, 3500); return; }
+    nightDone = true;
+    bubble(pick(LINES.night), 4200);
+  }
+
+  /* ---------- 场景二：点击补一句 ---------- */
+  function bindClick() {
+    if (!root) return false;
+    var body = root.querySelector('.sw-body');
+    if (!body) return false;
+    if (root.dataset.extraBound) return true;
+    root.dataset.extraBound = '1';
+    body.addEventListener('click', function () {
+      if (Math.random() > 0.7) return;
+      setTimeout(function () { bubble(pick(LINES.click), 3000); }, 900);
+    });
+  }
+
+  /* ---------- 场景三：出错时安慰 ---------- */
+  var comforts = 0;
+  function comfort() {
+    if (comforts >= 3) return;
+    comforts++;
+    setTimeout(function () { bubble(pick(LINES.comfort), 3000); }, 300);
+  }
+  window.addEventListener('error', comfort, true);
+  window.addEventListener('unhandledrejection', comfort);
+
+  /* ---------- 场景四：陪伴时长 → 羁绊 ---------- */
+  var tick = 0;
+  function heartbeat() {
+    if (document.hidden) return;
+    if (!nightDone) nightTip();
+    usage.seconds += 1;
+    tick += 1;
+    if (tick >= 60) {
+      tick = 0;
+      saveUsage(usage);
+    }
+    if (usage.gain >= 4) return;
+    if (usage.seconds % 900 !== 0) return;   /* 每 15 分钟一次，每天最多 4 次 */
+    usage.gain += 1;
+    saveUsage(usage);
+    try {
+      var s = currentSpirit();
+      SP.adjustBond(s ? s.id : undefined, 1);
+    } catch (e) {}
+    bubble(pick(LINES.growth).replace('%m', '15'), 3600);
+  }
+
+  document.addEventListener('visibilitychange', function () {
+    if (document.hidden) saveUsage(usage);
+  });
+
+  var booted = false;
+  function boot() {
+    if (!ensureExtra()) {
+      setTimeout(boot, 400);
+      return;
+    }
+    if (!bindClick()) setTimeout(boot, 400);
+    if (booted) return;
+    booted = true;
+    setTimeout(nightTip, 6000);
+    setInterval(heartbeat, 1000);
+  }
+
+  if (document.readyState === 'complete' || document.readyState === 'interactive') {
+    setTimeout(boot, 300);
+  } else {
+    document.addEventListener('DOMContentLoaded', function () { setTimeout(boot, 300); });
+  }
+})();
diff --git a/www/js/tafei-auth.js b/www/js/tafei-auth.js
new file mode 100644
index 0000000..5692506
--- /dev/null
+++ b/www/js/tafei-auth.js
@@ -0,0 +1,355 @@
+/* TAFEI 登录弹窗 · v1
+   我的页 / 任意页面共用：window.TafeiAuth.open('login'|'register')
+   账号体系 = 自定义账号 + 密码（内部映射为 账号@tafei.local），4 位数字验证码，可选绑定邮箱 */
+(function () {
+  'use strict';
+
+  var ORIGIN = 'https://kwkewmhmxyjmzdjyutwa.supabase.co';
+  var KEY = 'sb_publishable_tyeDf4FmwSW6j7C7s0Gdfg_Me5HqXkV';
+  var SUFFIX = '@tafei.local';
+  var SETTINGS_URL = 'https://piaony.github.io/tafei-site/';
+
+  var st = { mode: 'login', code: '', busy: false };
+  var mask = null, card = null, tabLogin = null, tabReg = null;
+  var formLogin = null, formReg = null, msgEl = null, canvasEl = null, toastEl = null;
+  var inputs = {};
+
+  function el(tag, cls, html) {
+    var n = document.createElement(tag);
+    if (cls) n.className = cls;
+    if (html != null) n.innerHTML = html;
+    return n;
+  }
+
+  function msg(text, ok) {
+    if (!msgEl) return;
+    msgEl.textContent = text || '';
+    msgEl.classList.toggle('on', !!text);
+    msgEl.classList.toggle('ok', !!ok);
+  }
+
+  var toastTimer = 0;
+  function showToast(text) {
+    if (!toastEl) {
+      toastEl = el('div', 'mc-toast');
+      toastEl.style.cssText = 'position:fixed;left:50%;bottom:calc(96px + env(safe-area-inset-bottom));'
+        + 'transform:translateX(-50%);max-width:80vw;padding:10px 16px;border-radius:14px;z-index:100070;'
+        + 'background:rgba(12,24,44,.94);border:1px solid rgba(130,170,255,.34);color:#eef4ff;'
+        + 'font-size:13px;text-align:center;opacity:0;transition:opacity .22s ease;pointer-events:none';
+      document.body.appendChild(toastEl);
+    }
+    toastEl.textContent = text;
+    toastEl.style.opacity = '1';
+    clearTimeout(toastTimer);
+    toastTimer = setTimeout(function () { toastEl.style.opacity = '0'; }, 2200);
+  }
+
+  /* ---------- 验证码 ---------- */
+  function drawCaptcha() {
+    var digits = '';
+    for (var i = 0; i < 4; i++) digits += String(Math.floor(Math.random() * 10));
+    st.code = digits;
+    var list = card ? card.querySelectorAll('.tfa-canvas') : [];
+    for (var n = 0; n < list.length; n++) paintCaptcha(list[n], digits);
+  }
+
+  function paintCaptcha(canvasEl, digits) {
+    if (!canvasEl) return;
+    var dpr = Math.min(3, window.devicePixelRatio || 1);
+    var w = 96, h = 40;
+    canvasEl.width = w * dpr;
+    canvasEl.height = h * dpr;
+    var c = canvasEl.getContext('2d');
+    if (!c) return;
+    c.setTransform(dpr, 0, 0, dpr, 0, 0);
+    var g = c.createLinearGradient(0, 0, w, h);
+    g.addColorStop(0, '#132a4f');
+    g.addColorStop(1, '#1d1a3d');
+    c.fillStyle = g;
+    c.fillRect(0, 0, w, h);
+    for (var k = 0; k < 26; k++) {
+      c.strokeStyle = 'rgba(' + (90 + Math.random() * 120 | 0) + ',' + (150 + Math.random() * 90 | 0) + ',255,' + (0.1 + Math.random() * 0.22).toFixed(2) + ')';
+      c.lineWidth = 0.6 + Math.random();
+      c.beginPath();
+      c.moveTo(Math.random() * w, Math.random() * h);
+      c.lineTo(Math.random() * w, Math.random() * h);
+      c.stroke();
+    }
+    var colors = ['#64e8ff', '#a9c2ff', '#e7bbff', '#8ef0d0'];
+    for (var j = 0; j < 4; j++) {
+      c.save();
+      var x = 12 + j * 21 + Math.random() * 4;
+      var y = 27 + (Math.random() * 6 - 3);
+      c.translate(x, y);
+      c.rotate((Math.random() * 0.5 - 0.25));
+      c.font = '800 ' + (20 + Math.random() * 3).toFixed(0) + 'px -apple-system,"PingFang SC",Arial,sans-serif';
+      c.fillStyle = colors[j % colors.length];
+      c.fillText(digits[j], 0, 0);
+      c.restore();
+    }
+  }
+
+  /* ---------- UI ---------- */
+  function buildUI() {
+    if (mask) return;
+    mask = el('div', 'tfa-mask');
+    card = el('div', 'tfa-card');
+    card.innerHTML =
+      '<div class="tfa-head">'
+      + '<div><h2 id="tfaTitle">登录挞飞</h2><p id="tfaSub">账号登录，进度、收藏和伙伴一起带走</p></div>'
+      + '<button class="tfa-x" type="button" aria-label="关闭">✕</button>'
+      + '</div>'
+      + '<div class="tfa-tabs"><button class="tfa-tab on" type="button" data-tab="login">登录</button>'
+      + '<button class="tfa-tab" type="button" data-tab="register">注册</button></div>'
+      + '<form class="tfa-form" id="tfaLoginForm" autocomplete="on">'
+      + '<div class="tfa-field"><label>账号</label>'
+      + '<input class="tfa-input" id="tfaLoginUser" type="text" inputmode="latin" autocapitalize="off" autocorrect="off" placeholder="例如 piaony"></div>'
+      + '<div class="tfa-field"><label>密码</label>'
+      + '<input class="tfa-input" id="tfaLoginPass" type="password" autocomplete="current-password" placeholder="输入密码"></div>'
+      + '<div class="tfa-field"><label>验证码</label>'
+      + '<div class="tfa-cap"><input class="tfa-input" id="tfaLoginCap" type="text" inputmode="numeric" maxlength="4" placeholder="4 位数字">'
+      + '<canvas class="tfa-canvas" id="tfaCanvas" width="96" height="40" title="点一下换一张"></canvas></div>'
+      + '<div class="tfa-cap-tip">看不清？点右侧图片换一张</div></div>'
+      + '<button class="tfa-submit" type="submit">登录</button>'
+      + '<div class="tfa-foot"><button class="tfa-link sub" type="button" data-act="forgot">忘记密码</button>'
+      + '<button class="tfa-link" type="button" data-act="to-register">没有账号？去注册</button></div>'
+      + '</form>'
+      + '<form class="tfa-form" id="tfaRegForm" hidden>'
+      + '<div class="tfa-field"><label>账号</label>'
+      + '<input class="tfa-input" id="tfaRegUser" type="text" inputmode="latin" autocapitalize="off" autocorrect="off" placeholder="3–16 位，字母/数字/下划线"></div>'
