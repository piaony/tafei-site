+        @JavascriptInterface
+        public void openAccessibility() {
+            act.runOnUiThread(new Runnable() {
+                @Override
+                public void run() {
+                    try {
+                        act.startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS));
