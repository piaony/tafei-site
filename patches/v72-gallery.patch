 }
+
+/* 伙伴图鉴：默认收纳为一条入口，点开后在窗口里展示全部角色 */
+.spirit-gallery-entry{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:12px 14px;border:1px solid var(--sp-line);border-radius:18px;background:linear-gradient(135deg,rgba(23,32,56,.9),rgba(13,19,36,.86));color:#eaf2ff;box-shadow:0 14px 34px rgba(0,0,0,.18)}
+.gallery-entry-face{flex:0 0 48px;width:48px;height:48px;border-radius:14px;overflow:hidden;border:1px solid rgba(255,211,110,.3);background:rgba(255,211,110,.07)}
+.gallery-entry-face img{width:100%;height:100%;object-fit:cover;display:block}
+.gallery-entry-copy{min-width:0;flex:1 1 150px}
+.gallery-entry-copy h2{margin:0;font-size:18px;line-height:1.3}
+.gallery-entry-copy p{margin:2px 0 0;color:var(--ang-muted);font-size:11.5px;line-height:1.5}
+.gallery-entry-copy b{color:var(--sp-gold);font-size:14px}
+.gallery-entry-actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-left:auto}
+.gallery-open-btn{min-height:36px;padding:0 15px;border:1px solid rgba(255,211,110,.42);border-radius:11px;background:rgba(255,211,110,.12);color:var(--sp-gold);font-size:12.5px;font-weight:600;cursor:pointer;white-space:nowrap}
+.gallery-open-btn:active{transform:translateY(1px)}
+
+.spirit-gallery-modal{position:fixed;inset:0;z-index:9000;display:grid;place-items:center;padding:16px;background:rgba(3,7,17,.84);backdrop-filter:blur(12px)}
+.spirit-gallery-modal[hidden]{display:none!important}
+.spirit-gallery-card{display:flex;flex-direction:column;width:min(960px,100%);max-height:min(88vh,900px);border:1px solid rgba(255,211,110,.2);border-radius:24px;overflow:hidden;background:linear-gradient(155deg,#111a31,#0a1020 58%,#140f22);color:#eaf2ff;--ang-text:#eaf2ff;--ang-muted:rgba(231,238,251,.62);box-shadow:0 30px 90px rgba(0,0,0,.5)}
+.spirit-gallery-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px 12px;border-bottom:1px solid var(--sp-line)}
+.gallery-kicker{display:block;color:var(--sp-cyan);font-size:9.5px;letter-spacing:.18em}
+.spirit-gallery-head h2{margin:2px 0 0;font-size:22px;line-height:1.2}
+.spirit-gallery-head p{margin:4px 0 0;color:var(--ang-muted);font-size:11.5px}
+.spirit-gallery-head .spirit-modal-close{flex:0 0 auto}
+.spirit-gallery-body{flex:1 1 auto;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:14px 18px;overscroll-behavior:contain}
+.spirit-gallery-body .spirit-grid{margin:0}
+.spirit-gallery-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 18px calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--sp-line);color:var(--ang-muted);font-size:10.5px}
+.spirit-gallery-foot button{min-height:32px;padding:0 12px;border:1px solid var(--sp-line);border-radius:9px;background:rgba(255,255,255,.05);color:var(--ang-text);font-size:11.5px;cursor:pointer;white-space:nowrap}
+
+@media(max-width:620px){
+ .spirit-gallery-entry{padding:11px 12px;gap:10px}
+ .gallery-entry-face{flex-basis:44px;width:44px;height:44px;border-radius:12px}
+ .gallery-entry-copy h2{font-size:16px}
+ .gallery-entry-copy p{font-size:10.5px}
+ .gallery-open-btn{min-height:34px;padding:0 12px;font-size:11.5px}
+ .spirit-gallery-modal{padding:0;align-items:flex-end;background:rgba(3,7,17,.9)}
+ .spirit-gallery-card{width:100%;max-height:90vh;border-radius:20px 20px 0 0;border-bottom:0}
+ .spirit-gallery-head{padding:14px 14px 10px}
+ .spirit-gallery-head h2{font-size:19px}
+ .spirit-gallery-body{padding:12px 12px 4px}
+ .spirit-gallery-foot{padding:9px 14px calc(9px + env(safe-area-inset-bottom))}
+ .spirit-gallery-foot span{max-width:62%;line-height:1.35}
+}
